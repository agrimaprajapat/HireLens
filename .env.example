# Azure OpenAI — copy this file to `.env.local` and fill in your values.
# `.env.local` is git-ignored; never commit real credentials.

# Base endpoint of your Azure OpenAI resource, e.g. https://my-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=

# API key for the Azure OpenAI resource.
AZURE_OPENAI_API_KEY=

# The name of your deployed model (must be a gpt-4o-mini deployment).
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Azure OpenAI API version (Structured Outputs require 2024-08-01-preview or later).
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- Postgres (Prisma) ---
# Pooled connection for the app; direct connection for migrations.
DATABASE_URL=
DIRECT_URL=

# --- Clerk (clerk.com -> API Keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Google Analytics (GA4) ---
# Measurement ID from analytics.google.com (Admin -> Data Streams). Leave blank
# to disable analytics (e.g. locally); set it only where you want tracking.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Paddle (Billing) ---
# Use "sandbox" for dev and "production" for live. Price IDs and keys differ
# between the two environments — never mix them.
NEXT_PUBLIC_PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Paddle price IDs per plan (from the Paddle dashboard; env-specific).
PADDLE_PRICE_STUDENT_PRO=
PADDLE_PRICE_PLACEMENT_PASS=
